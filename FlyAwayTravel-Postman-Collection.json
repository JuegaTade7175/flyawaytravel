{
  "info": {
    "_postman_id": "flyaway-travel-api-collection",
    "name": "FlyAway Travel API",
    "description": "Complete API collection for FlyAway Travel application with all endpoints",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"user@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "login"]
            },
            "description": "Authenticate user and return JWT token"
          },
          "response": []
        }
      ],
      "description": "Authentication endpoints"
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Register User",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john.doe@example.com\",\n  \"password\": \"password123\",\n  \"role\": \"USER\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/users/register",
              "host": ["{{baseUrl}}"],
              "path": ["users", "register"]
            },
            "description": "Register a new user in the system"
          },
          "response": []
        },
        {
          "name": "Get User by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}"]
            },
            "description": "Get user details by ID"
          },
          "response": []
        }
      ],
      "description": "User management endpoints"
    },
    {
      "name": "Flights",
      "item": [
        {
          "name": "Create Flight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"AA1234\",\n  \"airline\": \"American Airlines\",\n  \"origin\": \"New York\",\n  \"destination\": \"Los Angeles\",\n  \"departureTime\": \"2024-06-15T10:00:00\",\n  \"arrivalTime\": \"2024-06-15T13:00:00\",\n  \"price\": 299.99,\n  \"availableSeats\": 150\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/flights/create",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "create"]
            },
            "description": "Create a new flight"
          },
          "response": []
        },
        {
          "name": "Search Flights",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/search?flightNumber={{flightNumber}}&airline={{airline}}&startDate={{startDate}}&endDate={{endDate}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "search"],
              "query": [
                {
                  "key": "flightNumber",
                  "value": "{{flightNumber}}",
                  "description": "Optional: Flight number to search"
                },
                {
                  "key": "airline",
                  "value": "{{airline}}",
                  "description": "Optional: Airline name to filter"
                },
                {
                  "key": "startDate",
                  "value": "{{startDate}}",
                  "description": "Optional: Start date for search (ISO format)"
                },
                {
                  "key": "endDate",
                  "value": "{{endDate}}",
                  "description": "Optional: End date for search (ISO format)"
                }
              ]
            },
            "description": "Search flights with optional filters"
          },
          "response": []
        },
        {
          "name": "Get Flight by ID",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/flights/{{flightId}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "{{flightId}}"]
            },
            "description": "Get flight details by ID"
          },
          "response": []
        }
      ],
      "description": "Flight management endpoints"
    },
    {
      "name": "Bookings",
      "item": [
        {
          "name": "Book Flight",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": 1,\n  \"passengerName\": \"John Doe\",\n  \"passengerEmail\": \"john.doe@example.com\",\n  \"numberOfSeats\": 2,\n  \"totalPrice\": 599.98\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/flights/book",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "book"]
            },
            "description": "Book a flight for authenticated user"
          },
          "response": []
        },
        {
          "name": "Get Booking by ID (Flight endpoint)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/flights/book/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "book", "{{bookingId}}"]
            },
            "description": "Get booking details by ID (flights endpoint)"
          },
          "response": []
        },
        {
          "name": "Get User Bookings",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings",
              "host": ["{{baseUrl}}"],
              "path": ["bookings"]
            },
            "description": "Get all bookings for authenticated user"
          },
          "response": []
        },
        {
          "name": "Get Booking by ID",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{jwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/bookings/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["bookings", "{{bookingId}}"]
            },
            "description": "Get booking details by ID"
          },
          "response": []
        }
      ],
      "description": "Booking management endpoints"
    },
    {
      "name": "Admin",
      "item": [
        {
          "name": "Cleanup Database",
          "request": {
            "method": "DELETE",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{adminJwtToken}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/cleanup",
              "host": ["{{baseUrl}}"],
              "path": ["cleanup"]
            },
            "description": "Delete all data from database (Admin only)"
          },
          "response": []
        }
      ],
      "description": "Admin endpoints for system management"
    }
  ],
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080",
      "type": "string"
    },
    {
      "key": "jwtToken",
      "value": "",
      "type": "string",
      "description": "JWT authentication token for regular users"
    },
    {
      "key": "adminJwtToken",
      "value": "",
      "type": "string",
      "description": "JWT authentication token for admin users"
    },
    {
      "key": "userId",
      "value": "1",
      "type": "string",
      "description": "Sample user ID for testing"
    },
    {
      "key": "flightId",
      "value": "1",
      "type": "string",
      "description": "Sample flight ID for testing"
    },
    {
      "key": "bookingId",
      "value": "1",
      "type": "string",
      "description": "Sample booking ID for testing"
    },
    {
      "key": "flightNumber",
      "value": "",
      "type": "string",
      "description": "Flight number for search"
    },
    {
      "key": "airline",
      "value": "",
      "type": "string",
      "description": "Airline name for search"
    },
    {
      "key": "startDate",
      "value": "",
      "type": "string",
      "description": "Start date for flight search (ISO format)"
    },
    {
      "key": "endDate",
      "value": "",
      "type": "string",
      "description": "End date for flight search (ISO format)"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Pre-request script for global setup",
          "console.log('Executing pre-request script for FlyAway Travel API');"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Global test script",
          "pm.test('Response has valid status code', function () {",
          "    pm.expect(pm.response.code).to.be.oneOf([200, 201, 204, 400, 401, 403, 404, 500]);",
          "});"
        ]
      }
    }
  ]
}
