{
  "info": {
    "name": "FlyAway Travel API",
    "_postman_id": "flyawaytravel-collection-v1",
    "description": "Colección completa para el API de reserva de vuelos FlyAway Travel. Incluye todas las misiones Must Have y Nice to Have.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
