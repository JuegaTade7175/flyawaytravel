        },
        {
          "name": "6. Reservar vuelo",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('bookingId', json.id);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightId\": {{flightId}}\n}"
            },
            "url": { "raw": "{{baseUrl}}/flights/book", "host": ["{{baseUrl}}"], "path": ["flights", "book"] }
          },
          "response": []
        },
        {
          "name": "7. Ver reserva creada",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": {
              "raw": "{{baseUrl}}/flights/book/{{bookingId}}",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "book", "{{bookingId}}"]
            }
          },
          "response": []
        }
      ]
    }
  ]
}