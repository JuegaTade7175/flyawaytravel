  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8081",
      "type": "string"
    },
    {
      "key": "token",
      "value": "",
      "type": "string"
    },
    {
      "key": "userId",
      "value": "",
      "type": "string"
    },
    {
      "key": "flightId",
      "value": "",
      "type": "string"
    },
    {
      "key": "bookingId",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "🧹 CLEANUP",
      "item": [
        {
          "name": "DELETE /cleanup",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 200', () => pm.response.to.have.status(200));",
                  "pm.test('BD limpiada', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.message).to.include('cleaned');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "DELETE",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/cleanup",
              "host": ["{{baseUrl}}"],
              "path": ["cleanup"]
            },
            "description": "Limpia completamente la base de datos. Sin protección JWT."
          },
          "response": []
        }
      ]
    },
    {
      "name": "✈️ VUELOS (sin auth)",
      "item": [
        {
          "name": "POST /flights/create ✅",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Tiene flightNumber', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.flightNumber).to.exist;",
                  "    pm.collectionVariables.set('flightId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"flightNumber\": \"LA500\",\n  \"airline\": \"LATAM Airlines\",\n  \"departureTime\": \"2026-12-01T08:00:00\",\n  \"arrivalTime\": \"2026-12-01T12:00:00\",\n  \"availableSeats\": 150,\n  \"origin\": \"Lima\",\n  \"destination\": \"Bogotá\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/flights/create",
              "host": ["{{baseUrl}}"],
              "path": ["flights", "create"]
            },
            "description": "Crea un vuelo. Sin protección JWT. El ID se guarda automáticamente en {{flightId}}."
          },
          "response": []
        },
