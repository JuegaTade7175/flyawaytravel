    {
      "name": "📋 RESERVAS (con auth)",
      "item": [
        {
          "name": "POST /flights/book ✅",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test('Status 201', () => pm.response.to.have.status(201));",
                  "pm.test('Reserva creada correctamente', () => {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.id).to.exist;",
                  "    pm.expect(json.customerName).to.exist;",
                  "    pm.expect(json.bookingDate).to.exist;",
                  "    pm.expect(json.flight).to.exist;",
                  "    pm.collectionVariables.set('bookingId', json.id);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
