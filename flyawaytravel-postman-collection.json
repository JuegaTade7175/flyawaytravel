{
	"info": {
		"_postman_id": "flyawaytravel-api-collection",
		"name": "FlyawayTravel API",
		"description": "API collection for FlyawayTravel flight booking system",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"email\": \"user@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/auth/login",
							"host": ["{{baseUrl}}"],
							"path": ["auth", "login"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Users",
			"item": [
				{
					"name": "Register User",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"firstName\": \"John\",\n    \"lastName\": \"Doe\",\n    \"email\": \"john.doe@example.com\",\n    \"password\": \"password123\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/users/register",
							"host": ["{{baseUrl}}"],
							"path": ["users", "register"]
						}
					},
					"response": []
				},
				{
					"name": "Get User by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/users/1",
							"host": ["{{baseUrl}}"],
							"path": ["users", "1"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Flights",
			"item": [
				{
					"name": "Create Flight",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"airlineName\": \"American Airlines\",\n    \"flightNumber\": \"AA1234\",\n    \"estDepartureTime\": \"2029-06-15T10:00:00Z\",\n    \"estArrivalTime\": \"2029-06-15T13:00:00Z\",\n    \"availableSeats\": 150\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/flights/create",
							"host": ["{{baseUrl}}"],
							"path": ["flights", "create"]
						}
					},
					"response": []
				},
				{
					"name": "Create Multiple Flights",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"inputs\": [\n        {\n            \"airlineName\": \"LATAM Airlines\",\n            \"flightNumber\": \"LA500\",\n            \"estDepartureTime\": \"2026-12-01T08:00:00Z\",\n            \"estArrivalTime\": \"2026-12-01T12:00:00Z\",\n            \"availableSeats\": 150\n        },\n        {\n            \"airlineName\": \"Delta Airlines\",\n            \"flightNumber\": \"DL789\",\n            \"estDepartureTime\": \"2026-11-15T14:30:00Z\",\n            \"estArrivalTime\": \"2026-11-15T18:45:00Z\",\n            \"availableSeats\": 120\n        }\n    ]\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/flights/create-many",
							"host": ["{{baseUrl}}"],
							"path": ["flights", "create-many"]
						}
					},
					"response": []
				},
				{
					"name": "Search Flights",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/flights/search?flightNumber=AA1234&airlineName=American Airlines&estDepartureTimeFrom=2029-06-01T00:00:00Z&estDepartureTimeTo=2029-06-30T23:59:59Z",
							"host": ["{{baseUrl}}"],
							"path": ["flights", "search"],
							"query": [
								{
									"key": "flightNumber",
									"value": "AA1234",
									"description": "Optional: Filter by flight number"
								},
								{
									"key": "airlineName",
									"value": "American Airlines",
									"description": "Optional: Filter by airline name"
								},
								{
									"key": "estDepartureTimeFrom",
									"value": "2029-06-01T00:00:00Z",
									"description": "Optional: Filter by departure time from"
								},
								{
									"key": "estDepartureTimeTo",
									"value": "2029-06-30T23:59:59Z",
									"description": "Optional: Filter by departure time to"
								}
							]
						}
					},
					"response": []
				},
				{
					"name": "Get Flight by ID",
					"request": {
						"method": "GET",
						"header": [],
						"url": {
							"raw": "{{baseUrl}}/flights/1",
							"host": ["{{baseUrl}}"],
							"path": ["flights", "1"]
						}
					},
					"response": []
				}
			]
		},
		{
			"name": "Bookings",
			"item": [
				{
					"name": "Book Flight",
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n    \"flightId\": 1,\n    \"passengerName\": \"John Doe\",\n    \"passengerEmail\": \"john.doe@example.com\",\n    \"seatCount\": 2\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/flights/book",
							"host": ["{{baseUrl}}"],
							"path": ["flights", "book"]
						}
					},
					"response": []
				},
				{
					"name": "Get Booking by ID",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/flights/book/1",
							"host": ["{{baseUrl}}"],
							"path": ["flights", "book", "1"]
						}
					},
					"response": []
				},
				{
					"name": "Get User Bookings",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/bookings",
							"host": ["{{baseUrl}}"],
							"path": ["bookings"]
						}
					},
					"response": []
				},
				{
					"name": "Get Specific Booking",
					"request": {
						"method": "GET",
						"header": [
							{
								"key": "Authorization",
								"value": "Bearer {{jwtToken}}"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/bookings/1",
							"host": ["{{baseUrl}}"],
							"path": ["bookings", "1"]
						}
					},
					"response": []
				}
			]
		}
	],
	"variable": [
		{
			"key": "baseUrl",
			"value": "http://localhost:8081",
			"type": "string"
		},
		{
			"key": "jwtToken",
			"value": "",
			"type": "string"
		}
	]
}